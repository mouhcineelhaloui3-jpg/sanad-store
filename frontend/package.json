    "@tanstack/react-table": "^8.21.3",
    "clsx": "latest",
    "cmdk": "^1.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.40.0",
    "lucide-react": "latest",
    "next": "latest",
    "pg": "^8.21.0",
